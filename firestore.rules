rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny net: operational/PII records reside strictly in server-side SQLite
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives (Zero Hardcoded Emails)
    // ---------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function adminExists() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && adminExists() && adminData().role == 'super_admin';
    }

    function hasTenantAccess(tenantId) {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        adminExists() &&
        adminData().role == 'tenant_admin' &&
        adminData().allowedTenants is list &&
        tenantId in adminData().allowedTenants
      );
    }

    // ---------------------------------------------------------
    // Validation Blueprints
    // ---------------------------------------------------------
    function isValidAdminEntry(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'allowedTenants', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'allowedTenants', 'createdAt']) &&
        data.uid is string && data.uid == uid && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role in ['super_admin', 'tenant_admin'] &&
        data.allowedTenants is list && data.allowedTenants.size() <= 50 &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'revoked', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'revoked', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == uid && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['caller', 'tenant_admin', 'super_admin'] &&
        data.revoked is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTenantWorkspace(data, tenantId) {
      return data.keys().hasAll(['id', 'name', 'category', 'agentName', 'ownerUid', 'memberUids', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'agentName', 'webhookEnabled', 'ownerUid', 'memberUids', 'updatedAt']) &&
        data.id is string && data.id == tenantId && isValidId(data.id) && data.id.size() >= 2 && data.id.size() <= 80 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.category in ['clinic', 'coaching', 'logistics', 'university', 'custom'] &&
        data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 60 &&
        (!('webhookEnabled' in data) || data.webhookEnabled is bool) &&
        data.ownerUid is string && isValidId(data.ownerUid) &&
        data.memberUids is map && data.memberUids.size() <= 50 &&
        data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------

    // Connectivity probe path (non-PII)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Strictly super-admin managed RBAC directory (tenant_admins cannot list, create, elevate, or delete)
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(uid) && isSuperAdmin() && isValidAdminEntry(incoming(), uid) && incoming().createdAt == request.time;
      allow update: if isValidId(uid) && isSuperAdmin() && isValidAdminEntry(incoming(), uid) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(uid) && isSuperAdmin();
    }

    // OIDC User profiles (self-signup locked to least-privilege 'caller' + revoked: false)
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(uid) && incoming().role == 'caller' && incoming().revoked == false) ||
          isSuperAdmin()
        );
      allow update: if isValidId(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (isOwner(uid) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
    }

    // Strictly tenant-scoped workspace metadata (no cross-tenant get/list by verified callers)
    match /tenants/{tenantId} {
      allow get: if isValidId(tenantId) && hasTenantAccess(tenantId);
      allow list: if isSuperAdmin() || (
        isVerifiedUser() &&
        resource.data.memberUids is map &&
        resource.data.memberUids[request.auth.uid] == true
      );
      allow create: if isValidId(tenantId) && isSuperAdmin() && isValidTenantWorkspace(incoming(), tenantId) && incoming().updatedAt == request.time;
      allow update: if isValidId(tenantId) &&
        isValidTenantWorkspace(incoming(), tenantId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (hasTenantAccess(tenantId) && incoming().memberUids == existing().memberUids)
        );
      allow delete: if isValidId(tenantId) && isSuperAdmin();
    }
  }
}
