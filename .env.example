# GEMINI_API_KEY: Required for live Gemini AI API calls.
# Leave empty if running in explicit Offline Demo Mode.
GEMINI_API_KEY=

# SESSION_SECRET: Required in production (npm start / NODE_ENV=production).
# Must be at least 32 characters (e.g., `openssl rand -hex 32`).
SESSION_SECRET=

# ADMIN_BOOTSTRAP_TOKEN: Recommended for production deployments without ADMIN_PASSCODE.
# Required on POST /api/auth/bootstrap when claiming the first workspace administrator.
ADMIN_BOOTSTRAP_TOKEN=

# ADMIN_PASSCODE: Optional shared administrator passcode override.
# In production, at least one of ADMIN_PASSCODE, ADMIN_BOOTSTRAP_TOKEN, or an existing super_admin user is required.
ADMIN_PASSCODE=

# ADMIN_EMAIL: Optional explicit super-admin email promoted on verified Google OIDC sign-in.
# Leave empty unless intentionally granting initial super-admin role to a verified Google Workspace account.
ADMIN_EMAIL=

# FIREBASE_CHECK_REVOKED: Optional ("true" on user-owned GCP projects with IAM permissions; keep "false" on Starter Tier).
FIREBASE_CHECK_REVOKED=false

# CSP_FRAME_ANCESTORS: Content-Security-Policy frame-ancestors directive.
# Use "'self'" in strict standalone production or include "'self' https://aistudio.google.com" for iframe embeds.
CSP_FRAME_ANCESTORS='self'

# WEBHOOK_SIGNING_SECRET: Default HMAC-SHA256 secret used for outbound EHR/webhook signatures when a tenant override is omitted.
WEBHOOK_SIGNING_SECRET=

# ALLOW_LOCAL_WEBHOOKS: Keep false in production (blocks SSRF private/loopback targets); set true only for local integration testing.
ALLOW_LOCAL_WEBHOOKS=false

# APP_URL: Optional public URL where this service is hosted.
APP_URL=
