# GEMINI_API_KEY: Required for live Gemini AI API calls.
# Leave empty if running in explicit Offline Demo Mode.
GEMINI_API_KEY=

# APP_URL: Optional public URL where this service is hosted.
APP_URL=

# ADMIN_PASSCODE: Optional workspace administrator passcode.
# If unset, the first visitor to the Admin Access panel can claim the initial admin account via scrypt-hashed bootstrap.
ADMIN_PASSCODE=
