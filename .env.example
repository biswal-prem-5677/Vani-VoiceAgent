# GEMINI_API_KEY: Required for live Gemini AI API calls.
# Leave empty if running in explicit Offline Demo Mode.
GEMINI_API_KEY=

# SESSION_SECRET: Required in production (npm start / NODE_ENV=production).
# Must be at least 32 characters (e.g., `openssl rand -hex 32`).
SESSION_SECRET=

# ADMIN_BOOTSTRAP_TOKEN: Recommended for production deployments without ADMIN_PASSCODE.
# Required on POST /api/auth/bootstrap when claiming the first workspace administrator.
ADMIN_BOOTSTRAP_TOKEN=

# ADMIN_PASSCODE: Optional shared administrator passcode override.
# In production, at least one of ADMIN_PASSCODE, ADMIN_BOOTSTRAP_TOKEN, or an existing super_admin user is required.
ADMIN_PASSCODE=

# APP_URL: Optional public URL where this service is hosted.
APP_URL=
