{
  "entities": {
    "AdminEntry": {
      "title": "Admin Entry",
      "description": "Authorized workspace administrator record keyed by Firebase UID with explicit super_admin or tenant_admin scope",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "tenant_admin"] },
        "allowedTenants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "maxItems": 50
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "allowedTenants", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "OIDC-authenticated user profile metadata (authoritative auth/sessions remain on server)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["caller", "tenant_admin", "super_admin"] },
        "revoked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "revoked", "createdAt", "updatedAt"]
    },
    "TenantWorkspace": {
      "title": "Tenant Workspace",
      "description": "Tenant configuration directory summary scoped by explicit tenant membership and super_admin ownership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["clinic", "coaching", "logistics", "university", "custom"] },
        "agentName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "webhookEnabled": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUids": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "agentName", "ownerUid", "memberUids", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Super-admin-managed RBAC allowlist specifying role and allowedTenants per admin UID"
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records isolated to owner or super_admin"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/TenantWorkspace" },
      "description": "Tenant-scoped directory metadata; all operational PII (call logs, handoffs, appointments, tickets) is stored solely on the authoritative server SQLite store"
    }
  }
}
